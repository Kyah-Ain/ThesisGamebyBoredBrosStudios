    "m_FunctionSource": "",
    "m_FunctionBody": "#if defined(LIGHTMAP_ON)\nfloat2 lmUV = UV1 * unity_LightmapST.xy + unity_LightmapST.zw;\nColor = SampleLightmap(lmUV, WorldNormal);\n#else\nColor = float3(0, 0, 0);\n#endif"
}

