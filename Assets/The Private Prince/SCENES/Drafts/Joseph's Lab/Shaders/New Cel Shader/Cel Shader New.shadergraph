{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "9c0c0b1bfb5c432db589a66d29c36651",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MainLightWithShadows (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1010.9999389648438,
            "y": 207.00001525878907,
            "width": 288.0,
            "height": 245.00001525878907
        }
    },
    "m_Slots": [
        {
            "m_Id": "639781d493a24c048eda6e2735755f34"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLightWithShadows",
    "m_FunctionSource": "",
    "m_FunctionBody": "void MainLightWithShadows_half(float3 WorldPos, out half3 Direction, out half3 Color, out half DistanceAtten, out half ShadowAtten)\r\n{\r\n    #if defined(SHADERGRAPH_PREVIEW)\r\n        Direction = half3(0.5, 0.5, 0);\r\n        Color = 1;\r\n        DistanceAtten = 1;\r\n        ShadowAtten = 1;\r\n    #else\r\n        #if SHADOWS_SCREEN\r\n            half4 clipPos = TransformWorldToHClip(WorldPos);\r\n            half4 shadowCoord = ComputeScreenPos(clipPos);\r\n        #else\r\n            half4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n        #endif\r\n\r\n        Light mainLight = GetMainLight(shadowCoord);\r\n        Direction = mainLight.direction;\r\n        Color = mainLight.color;\r\n        DistanceAtten = mainLight.distanceAttenuation;\r\n        ShadowAtten = mainLight.shadowAttenuation;\r\n    #endif\r\n}"
}

