  m_Script: {fileID: 11500000, guid: e5c364ea64bdf614b9dda1453a961805, type: 3}
  m_Name: Mission4_SecubotToTandang
  m_EditorClassIdentifier: 
  speechLines:
  - 'Secubot: [D...DETECTING...ANOMALY...]'
  - '* Secubot Shut Down *'
  - 'Tandang: It looks recently beaten down, its memory ripped off carefully...'
  - "Tandang: ...it\u2019s like a surgeon freshly removing a foreign object."
  - "Tandang: There ain\u2019t any debris here either, the scene is practically clean."
  - 'Tandang: Lastly, with the memory gone, they could deliberately be removing evidence
    of their crimes.'
  - 'Tandang: Whoever the assailant may be, they are one organized fella.'
  - 'Tandang: Its last words, though...what does it mean by that?'
  - '* A loud noise occurred *'
